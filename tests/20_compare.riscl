%% { every comparison, taken and not, signed; prints 1 when taken and 0 when not }
$h = 0 + 10;
$a = 0 - 3;
$b = 0 + 2;
$c = 0 - 3;
$a < $b ? @0x10 : @0x11;   @0x10 !1; @0x12 ?; @0x11 !0; @0x12
$b < $a ? @0x20 : @0x21;   @0x20 !1; @0x22 ?; @0x21 !0; @0x22
$a <= $c ? @0x30 : @0x31;  @0x30 !1; @0x32 ?; @0x31 !0; @0x32
$b <= $a ? @0x40 : @0x41;  @0x40 !1; @0x42 ?; @0x41 !0; @0x42
$a == $c ? @0x50 : @0x51;  @0x50 !1; @0x52 ?; @0x51 !0; @0x52
$a == $b ? @0x60 : @0x61;  @0x60 !1; @0x62 ?; @0x61 !0; @0x62
$a != $b ? @0x70 : @0x71;  @0x70 !1; @0x72 ?; @0x71 !0; @0x72
$a != $c ? @0x80 : @0x81;  @0x80 !1; @0x82 ?; @0x81 !0; @0x82
$b > $a ? @0x90 : @0x91;   @0x90 !1; @0x92 ?; @0x91 !0; @0x92
$a > $b ? @0xa0 : @0xa1;   @0xa0 !1; @0xa2 ?; @0xa1 !0; @0xa2
$a >= $c ? @0xb0 : @0xb1;  @0xb0 !1; @0xb2 ?; @0xb1 !0; @0xb2
$a >= $b ? @0xc0 : @0xc1;  @0xc0 !1; @0xc2 ?; @0xc1 !0; @0xc2
!'$h;
%% { numbers on either side, and numbers too wide for 32 bits: 0xffffffffffffffff is -1 }
5 > 3 ? @0x100 : @0x101;                        @0x100 !1; @0x102 ?; @0x101 !0; @0x102
0xffffffffffffffff < 0 ? @0x110 : @0x111;       @0x110 !1; @0x112 ?; @0x111 !0; @0x112
$a < 0x100000000 ? @0x120 : @0x121;             @0x120 !1; @0x122 ?; @0x121 !0; @0x122
0x8000000000000000 < $a ? @0x130 : @0x131;      @0x130 !1; @0x132 ?; @0x131 !0; @0x132
$b == 2 ? @0x140 : @0x141;                      @0x140 !1; @0x142 ?; @0x141 !0; @0x142
!'$h;
#0;
