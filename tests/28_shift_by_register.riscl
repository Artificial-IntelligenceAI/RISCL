%% { shift counts from registers use their low 6 bits; >> keeps the sign }
$h = 0 + 10;
$a = 0 + 1;
$c = 0 + 0;  $b = $a << $c; !$b; !'$h;
$c = 0 + 63; $b = $a << $c; !$b; !'$h;
$c = 0 + 64; $b = $a << $c; !$b; !'$h;
$c = 0 + 65; $b = $a << $c; !$b; !'$h;
$c = 0 - 1;  $b = $a << $c; !$b; !'$h;
$a = 0 - 1000;
$c = 0 + 3;  $b = $a >> $c; !$b; !'$h;
$c = 0 + 63; $b = $a >> $c; !$b; !'$h;
$c = 0 + 67; $b = $a >> $c; !$b; !'$h;
$a = $a >> $c; !$a; !'$h;
$a = 0 + 1000; $a = $a >> 2; !$a; !'$h;
#0;
