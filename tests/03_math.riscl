%% { every math operator, one result per line }
$h = 0 + 10;
$a = 7 + 5; !$a; !'$h;
$a = 7 - 12; !$a; !'$h;
$a = 6 * 7; !$a; !'$h;
$a = 0 - 7; $b = $a / 2; !$b; !'$h;
$b = $a % 2; !$b; !'$h;
$a = 12 & 10; !$a; !'$h;
$a = 12 | 10; !$a; !'$h;
$a = 12 ^ 10; !$a; !'$h;
$a = 1 << 10; !$a; !'$h;
$a = 0 - 64; $b = $a >> 2; !$b; !'$h;
$a = 5 << 65; !$a; !'$h;
#0;
