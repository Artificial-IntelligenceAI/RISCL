%% { numbers wider than 32 bits in every place an operand goes }
$h = 0 + 10;
$a = 0 + 0x100000000;
$b = $a + 0x100000000; !$b; !'$h;
$b = $a - 0x200000000; !$b; !'$h;
$b = $a * 0x100000000; !$b; !'$h;
$b = $a * 0x7fffffff; !$b; !'$h;
$b = $a & 0x1ffffffff; !$b; !'$h;
$b = $a | 0xff00000000; !$b; !'$h;
$b = $a ^ 0x4294967296; !$b; !'$h;
$b = 0x1000000000000 / $a; !$b; !'$h;
$b = 0x1000000000005 % $a; !$b; !'$h;
$b = $a / 0x80000000; !$b; !'$h;
$b = $a / 0xffffffffffffffff; !$b; !'$h;
$c = 0x2 - 0x7fffffffffffffff; !$c; !'$h;
[16] = 0x123456789abcdef0;
$d = [16]; !$d; !'$h;
[24] = 0xffffffff80000000;
$d = [24]; !$d; !'$h;
[32] = 2147483648;
$d = [32]; !$d; !'$h;
#0;
